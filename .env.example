APP_NAME="7Cav Leadership Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Throw when Inertia renders a page with no file under resources/js/Pages. On in the test suite to catch a
# renamed page; leave off where only built assets are deployed.
INERTIA_ENSURE_PAGES_EXIST=false

# MySQL 8.4 LTS — the pinned database (AD-23: credentials live here / in env, never in the repo).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=7cav_backoffice
DB_USERNAME=7cav
DB_PASSWORD=

SESSION_DRIVER=database
# Minutes of idle time before a session expires — 1440 = the 24h window (NFR5, proposal §10.2).
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie only over HTTPS (NFR5). Leave unset: it defaults to true in production and false elsewhere.
# SESSION_SECURE_COOKIE=

# Comma-separated IPs/CIDRs of the load balancer or reverse proxy in front of the app (never `*`).
# Needed so the sign-in throttle sees each client's own IP and HSTS sees HTTPS. Leave empty with no proxy.
TRUSTED_PROXIES=

# The content security policy (config/csp.php) is enforced. true sends it as Content-Security-Policy-Report-Only:
# browsers log what it would block in the console and block nothing, while frame-ancestors stays enforced.
CSP_REPORT_ONLY=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before a reserved job counts as stuck and is handed to another worker. Keep it above the
# longest job timeout (SyncLoasJob, 900 s), or a running LOA sync is picked up again and burns its retries.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- 7Cav SSO (machine credentials, AD-23) ---
# Stored 7cav.us OAuth2 *client* credentials — NOT user passwords (AD-6 stores none).
# Wired in Story 1.4; documented here so the contract is complete from day one. Leave empty.
# The redirect path below is the *planned* callback — confirm/adjust it in Story 1.4
# (OAuth client registration is part of the deferred S6 conversation, AD-23).
SEVENCAV_OAUTH_CLIENT_ID=
SEVENCAV_OAUTH_CLIENT_SECRET=
SEVENCAV_OAUTH_REDIRECT_URI="${APP_URL}/auth/callback"
# Forum OAuth2 endpoints (XenForo 2.3), verified live on 7cav.us. Token/profile hang off
# {base}/api (POST /api/oauth2/token, GET /api/me); authorize is the browser redirect target.
SEVENCAV_FORUM_BASE_URL=https://7cav.us
SEVENCAV_OAUTH_AUTHORIZE_URL=https://7cav.us/oauth2/authorize
# Comma-separated read-only scopes only (proposal §10.2). Confirm exact identifier in 7cav.us admin.
SEVENCAV_OAUTH_SCOPES=user:read

# --- Forum leave threads (Story 4.1, AD-23) ---
# Reading LOA/ELOA threads uses a forum API key, a machine credential created in the
# forum's admin panel (API keys) with the node:read and thread:read scopes, tied to an account that can
# view the sections below. Read-only; it is NOT the OAuth login client above.
# Env only; never the DB, never version control. Leave empty here.
SEVENCAV_FORUM_API_KEY=
# The forum sections that hold leave threads, as `section id:type` pairs (the id is the number in the
# section's forum URL; the type is loa or eloa). The forum keeps one LOA section per
# battalion plus one for HHQ / non-battalion troopers, and one section for ELOA:
#   180 = LOA 1-7, 400 = LOA ACD, 540 = LOA 3-7, 178 = LOA 2-7, 369 = LOA HHQ, 341 = ELOA
# Not a secret. Only these sections are ever read; empty means none is.
SEVENCAV_FORUM_LOA_NODES=180:loa,400:loa,540:loa,178:loa,369:loa,341:eloa
# The PAFs forum, where personnel action forms are filed (365). An ELOA starts, and ends, on the day its PAF
# was filed, which can be a day before the report is posted, so the sync reads the creation date of the PAF
# thread an ELOA post links to. Only that date is read, never the PAF itself, and the key's account needs
# to be able to see the section. Empty means PAFs are not followed.
SEVENCAV_FORUM_PAF_NODE=365

# --- LOA sync (Story 4.2) ---
# Scheduled in routes/console.php (`php artisan schedule:list`), once the forum key and leave sections above are set.
# Pause between requests to the forum, in milliseconds, so a first backfill does not hammer it.
LOA_SYNC_REQUEST_DELAY_MS=200

# --- 7Cav roster/milpac API (machine credential, AD-23) ---
# api.7cav.us is a DIFFERENT service from the forum above: read-only JSON, authenticated with a
# static bearer key (NOT OAuth). Generate one at https://7cav.us/account/api-key — it looks like
# `cav7_…`. Env only (AD-23); never the DB, never version control. Leave empty here.
# Wired in Story 1.6 (profile enrichment); the same key serves the Epic 2 roster sync.
CAV_API_BASE_URL=https://api.7cav.us
CAV_API_KEY=
# Wall-clock ceiling for a first-login roster sweep (up to three calls, on the login path).
# Enrichment is optional, so it gives up rather than block a login indefinitely.
CAV_API_SWEEP_BUDGET_SECONDS=12

# Demo tools (#115). When true, an Admin can generate and purge demo attendance history for the
# real roster (Settings → Demo data, `php artisan portal:demo-history`). Leave false in production.
DEMO_TOOLS=false

# The in-portal guides at /docs (#407). When false every docs route answers 404 and the sidebar shows
# no Docs entry. On for testers during testing; on in production once the docs are rolled out.
DOCS_ENABLED=false
# Where "Was this helpful? No" on a guide sends the reader (a forum thread or a mailto: link). Empty hides it.
DOCS_FEEDBACK_URL=
# The folder the guides are read from. Leave empty for resources/docs; the browser tests point it at a fixed set.
DOCS_PATH=

# How many Cav weeks back from the current one a rollcall or weekly report may still be written.
# Older weeks are refused. 20 matches the roster's attendance matrix, the longest history shown.
PORTAL_WEEK_FLOOR_WEEKS=20

# Joint Service Achievement Medal candidates on the roster's "Guests at our practices" panel: at least
# JSAM_MIN_VISITS practices of the viewed unit's sections attended as a guest, and the guest's own SP %
# at least JSAM_MIN_OWN_SP_PERCENT, both over the last JSAM_WINDOW_WEEKS Cav weeks. Agreed with S1.
JSAM_MIN_VISITS=3
JSAM_MIN_OWN_SP_PERCENT=75
JSAM_WINDOW_WEEKS=12

# --- CRCON (Hell Let Loose player presence, Story 7.3; machine credential, AD-23) ---
# Read-only seam: the portal only reads the player history, never issues server commands.
# Base URL of the unit's CRCON (e.g. https://crcon.example.org) and an API key for it. Env only;
# never the DB, never version control. Leave empty here.
CRCON_BASE_URL=
CRCON_API_KEY=

# --- BattleMetrics (Arma Reforger player presence, HLL fallback, Story 7.4; machine credential, AD-23) ---
# Read-only seam: the portal only reads server session history and lists the servers the key has
# RCON access to (Settings > Servers, #389). API key from the unit's BattleMetrics account. Env
# only; never the DB, never version control. Leave empty here. BASE_URL only needs setting to point
# at a stand-in. SERVER_ID is the legacy single server: read only for a game with no server
# selected on the Servers page.
BATTLEMETRICS_BASE_URL=https://api.battlemetrics.com
BATTLEMETRICS_API_KEY=
BATTLEMETRICS_SERVER_ID=

# --- Nightwatch (WARDOGS player presence, Story 7.10; machine credential, AD-23) ---
# Read-only seam: the portal only reads Nightwatch's public stats API (GET, X-Api-Key). Workspace
# API key from the unit's Nightwatch console. Env only; never the DB, never version control. Leave
# empty here. BASE_URL only needs setting to point at a stand-in. SERVER_IDS (a comma list) is the
# legacy server list: read only for a game with no server selected on the Servers page (#389).
NIGHTWATCH_BASE_URL=https://nightwatch.to/api/public/stats
NIGHTWATCH_API_KEY=
NIGHTWATCH_SERVER_IDS=

# --- Google service account (the Sheets push below; machine credential, AD-23) ---
# A Google Cloud service account: from its JSON key file, the `client_email` and the `private_key` (paste it on one
# line, with its line breaks written as \n). Env only; never the DB, never version control. Leave both empty here.
# These were GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL / GOOGLE_DRIVE_PRIVATE_KEY before #565 removed the Drive copy.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Google Sheets (copies of the weekly staff reports; machine credential, AD-23) ---
# Each sent staff report is appended as one row to this spreadsheet by a queued job, signed in as the Google service
# account above. Share the spreadsheet with that email as an Editor. SPREADSHEET_ID is the long id in the sheet's URL, between /d/ and /edit. Platoon and company reports go to
# the staff tab, battalion reports (ACD included) to the battalion tab; leave the tab names empty for the defaults.
# Leave the id empty here: with no id nothing is pushed and nothing fails.
GOOGLE_SHEETS_REPORTS_SPREADSHEET_ID=
GOOGLE_SHEETS_STAFF_TAB=
GOOGLE_SHEETS_BATTALION_TAB=
